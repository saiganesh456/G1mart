# G1 MART — Environment Variables
# Names only — do NOT add real secrets or values to this file.
# Copy to .env.local for local development.

# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only
SUPABASE_SERVICE_ROLE_KEY=

# PhonePe Payment Gateway (Server-Only)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_ENV=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Google Maps API
# GOOGLE_MAPS_API_KEY: Server-Only secret key used for Distance Matrix API (driving distances & durations).
# Never expose to browser bundles!
GOOGLE_MAPS_API_KEY=

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Browser-Only Maps key (optional).
# Must be restricted by HTTP referrer (e.g. *.g1mart.com/*, localhost:3000/*) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=

# Firebase Phone Auth (10,000 free OTPs/mo)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
