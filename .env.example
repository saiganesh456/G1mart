# G1 MART — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ---------------------------------------------------------------------------
# SUPABASE — Public (safe to expose in browser bundles)
# Get from: https://supabase.com/dashboard/project/<id>/settings/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# ---------------------------------------------------------------------------
# SUPABASE — Server only (NEVER prefix with NEXT_PUBLIC_)
# Used only in Next.js Route Handlers and Server Actions.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ---------------------------------------------------------------------------
# PHONEPE PAYMENT GATEWAY — Server only (Phase 2)
# ---------------------------------------------------------------------------
PHONEPE_MERCHANT_ID="your-merchant-id"
PHONEPE_SALT_KEY="your-salt-key"
PHONEPE_SALT_INDEX="1"
# Use "PRODUCTION" for live; "UAT" for testing
PHONEPE_ENV="UAT"

# ---------------------------------------------------------------------------
# GOOGLE MAPS API (Optional - Server only)
# Used for high-accuracy reverse geocoding and address autocomplete in India.
# If omitted, OpenStreetMap Nominatim is automatically used for free.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
